# =============================================================================
# Side Workflow: Validated Novel RdRp -> PalmDB/Serratus Snowball -> Phase 2
# =============================================================================
# 1. Extracts structurally validated novel RdRp proteins from Stage 15 ESM-RdRp
# 2. Matches them against PalmDB via DIAMOND blastp to identify Serratus sOTUs
# 3. Queries Serratus RDS (palm_sra2 + srarun) for high-coverage, paired-end
#    Illumina SRA runs carrying sister lineages (excluding already-run samples)
# 4. Emits a Phase 2 manifest (`results/snowball/manifest_snowball.csv`) ready
#    to feed directly into the general Phase 2 + analysis_novel workflow.
#
# Run discovery only (safe preview before downloading reads):
#   snakemake -s Snakefile_snowball --use-conda --cores 4 snowball_discover
# =============================================================================

import os

configfile: "configs/snowball.yaml"

INP = config.get("inputs", {})
PDB = config.get("palmdb", {})
OUT_DIR = config.get("output", {}).get("dir", "results/snowball")
ENV_SNOWBALL = "envs/env_snowball.yaml"


rule snowball_discover:
    input:
        faa        = f"{OUT_DIR}/validated_novel_rdrps.faa",
        candidates = f"{OUT_DIR}/snowball_candidate_runs.tsv",
        manifest   = f"{OUT_DIR}/manifest_snowball.csv",
        combined   = f"{OUT_DIR}/manifest_combined.csv",


rule extract_validated_rdrps:
    """Pull structurally validated novel RdRp proteins from Stage 15 ESM-RdRp."""
    input:
        validation = INP["esm_validation_tsv"],
        selected   = INP["esm_selected_faa"],
    output:
        faa = f"{OUT_DIR}/validated_novel_rdrps.faa",
        tsv = f"{OUT_DIR}/validated_novel_rdrps.tsv",
    params:
        verdicts = ",".join(INP.get("verdicts", ["validated_rdrp_high", "validated_rdrp_moderate"])),
    log:
        "logs/snowball/extract_validated_rdrps.log",
    shell:
        """
        mkdir -p $(dirname {log}) $(dirname {output.faa})
        python3 scripts/extract_validated_rdrps.py \
            --validation-tsv "{input.validation}" \
            --selected-faa "{input.selected}" \
            --verdicts "{params.verdicts}" \
            --out-faa "{output.faa}" \
            --out-tsv "{output.tsv}" \
            > "{log}" 2>&1
        """


rule match_palmdb:
    """Map validated novel RdRps to PalmDB sOTU IDs via DIAMOND blastp."""
    input:
        faa = f"{OUT_DIR}/validated_novel_rdrps.faa",
    output:
        hits = f"{OUT_DIR}/palmdb_hits.tsv",
    params:
        palmdb_faa    = PDB.get("fasta", "../references/palmdb/palmdb_rdrp_seqs.fa"),
        palmdb_url    = PDB.get("url", ""),
        auto_download = "1" if PDB.get("auto_download", True) else "0",
        max_evalue    = float(PDB.get("max_evalue", 1e-5)),
        min_pident    = float(PDB.get("min_pident", 40.0)),
    threads: 4
    conda:
        ENV_SNOWBALL
    log:
        "logs/snowball/match_palmdb.log",
    shell:
        """
        mkdir -p $(dirname {log}) "$(dirname "{params.palmdb_faa}")"
        if [ ! -s "{input.faa}" ]; then
            : > "{output.hits}"
            echo "[match_palmdb] Empty query FASTA; skipping DIAMOND." > "{log}"
            exit 0
        fi
        if [ ! -s "{params.palmdb_faa}" ] && [ "{params.auto_download}" = "1" ] && [ -n "{params.palmdb_url}" ]; then
            echo "[match_palmdb] Downloading PalmDB FASTA -> {params.palmdb_faa}" > "{log}"
            curl -fsSL --retry 3 "{params.palmdb_url}" -o "{params.palmdb_faa}.tmp" >> "{log}" 2>&1 || true
            if [ -s "{params.palmdb_faa}.tmp" ]; then
                mv "{params.palmdb_faa}.tmp" "{params.palmdb_faa}"
            else
                rm -f "{params.palmdb_faa}.tmp"
            fi
        fi
        if [ ! -s "{params.palmdb_faa}" ]; then
            : > "{output.hits}"
            echo "[match_palmdb] PalmDB FASTA unavailable; continuing with seed-run sOTU snowball." >> "{log}"
            exit 0
        fi
        DB_PREFIX="{params.palmdb_faa}.dmnd"
        if [ ! -s "${{DB_PREFIX}}" ]; then
            diamond makedb --in "{params.palmdb_faa}" -d "{params.palmdb_faa}" >> "{log}" 2>&1
        fi
        diamond blastp \
            --query "{input.faa}" \
            --db "${{DB_PREFIX}}" \
            --out "{output.hits}" \
            --outfmt 6 qseqid sseqid pident length evalue bitscore \
            --evalue {params.max_evalue} \
            --id {params.min_pident} \
            --sensitive \
            --max-target-seqs 25 \
            --threads {threads} \
            >> "{log}" 2>&1
        """


rule serratus_snowball_manifest:
    """Query Serratus RDS for sister-lineage SRA runs and emit Phase 2 manifest."""
    input:
        validated = f"{OUT_DIR}/validated_novel_rdrps.tsv",
        hits      = f"{OUT_DIR}/palmdb_hits.tsv",
    output:
        candidates = f"{OUT_DIR}/snowball_candidate_runs.tsv",
        manifest   = f"{OUT_DIR}/manifest_snowball.csv",
        combined   = f"{OUT_DIR}/manifest_combined.csv",
    params:
        cfg      = "configs/snowball.yaml",
        existing = INP.get("existing_manifest", "../data/intake/manifest.csv"),
    conda:
        ENV_SNOWBALL
    log:
        "logs/snowball/serratus_snowball.log",
    shell:
        """
        mkdir -p $(dirname {log})
        EXISTING_ARG=""
        if [ -s "{params.existing}" ]; then
            EXISTING_ARG="--existing-manifest {params.existing}"
        fi
        python3 scripts/serratus_snowball.py \
            --config "{params.cfg}" \
            --palmdb-hits "{input.hits}" \
            --validated-tsv "{input.validated}" \
            $EXISTING_ARG \
            --out-candidates "{output.candidates}" \
            --out-manifest "{output.manifest}" \
            --out-combined "{output.combined}" \
            > "{log}" 2>&1
        """


rule snowball_cross_match:
    """Screen assembled Snowball_RdRp viral contigs against original validated novel RdRps."""
    input:
        seed_faa = f"{OUT_DIR}/validated_novel_rdrps.faa",
    output:
        hits = f"{OUT_DIR}/snowball_vs_seed_blastx.tsv",
    params:
        contigs_glob = "../data/03.rnaviralSPAdes/Snowball_RdRp/*/filtered_contigs.fasta",
        evalue       = 1e-10,
        min_pident   = 40.0,
    threads: 4
    conda:
        ENV_SNOWBALL
    log:
        "logs/snowball/snowball_cross_match.log",
    shell:
        """
        mkdir -p $(dirname {log}) "{OUT_DIR}/tmp_cross"
        TMP_CONTIGS="{OUT_DIR}/tmp_cross/snowball_contigs_prefixed.fasta"
        : > "${{TMP_CONTIGS}}"
        for f in {params.contigs_glob}; do
            [ -s "$f" ] || continue
            RUN_ID="$(basename "$(dirname "$f")")"
            awk -v rid="$RUN_ID" '/^>/{{print ">" rid "|" substr($0,2); next}} {{print}}' "$f" >> "${{TMP_CONTIGS}}"
        done
        if [ ! -s "${{TMP_CONTIGS}}" ] || [ ! -s "{input.seed_faa}" ]; then
            printf "qseqid\tsseqid\tpident\tlength\tqlen\tslen\tevalue\tbitscore\n" > "{output.hits}"
            echo "[snowball_cross_match] No contigs or seed FAA found; wrote empty table." > "{log}"
            exit 0
        fi
        diamond makedb --in "{input.seed_faa}" -d "{OUT_DIR}/tmp_cross/seed_rdrps" > "{log}" 2>&1
        printf "qseqid\tsseqid\tpident\tlength\tqlen\tslen\tevalue\tbitscore\n" > "{output.hits}"
        diamond blastx \
            --query "${{TMP_CONTIGS}}" \
            --db "{OUT_DIR}/tmp_cross/seed_rdrps.dmnd" \
            --outfmt 6 qseqid sseqid pident length qlen slen evalue bitscore \
            --evalue {params.evalue} \
            --id {params.min_pident} \
            --sensitive \
            --max-target-seqs 5 \
            --threads {threads} \
            >> "{output.hits}" 2>> "{log}"
        rm -rf "{OUT_DIR}/tmp_cross"
        """


OPEN_HOST_DIR = "results/open_host"


rule open_host_specificity:
    """Open-host Serratus query (no host filter) + Option-B spot-check manifest."""
    input:
        hits      = f"{OUT_DIR}/palmdb_hits.tsv",
        validated = f"{OUT_DIR}/validated_novel_rdrps.tsv",
    output:
        candidates  = f"{OPEN_HOST_DIR}/open_host_candidates.tsv",
        specificity = f"{OPEN_HOST_DIR}/open_host_sotu_specificity.tsv",
        manifest    = f"{OPEN_HOST_DIR}/manifest_spotcheck.csv",
    params:
        existing = INP.get("existing_manifest", "../data/intake/manifest.csv"),
    conda:
        ENV_SNOWBALL
    log:
        "logs/snowball/open_host_specificity.log",
    shell:
        """
        mkdir -p $(dirname {log}) "{OPEN_HOST_DIR}"
        TMP_CFG="{OPEN_HOST_DIR}/snowball_open_host.yaml"
        sed 's/^  host_regex:.*/  host_regex: ""/; s/^  max_total_runs:.*/  max_total_runs: 500/; s/^  max_runs_per_bioproject:.*/  max_runs_per_bioproject: 0/' \
            configs/snowball.yaml > "${{TMP_CFG}}"
        EXISTING_ARG=""
        [ -s "{params.existing}" ] && EXISTING_ARG="--existing-manifest {params.existing}"
        python3 scripts/serratus_snowball.py \
            --config "${{TMP_CFG}}" \
            --palmdb-hits "{input.hits}" \
            --validated-tsv "{input.validated}" \
            $EXISTING_ARG \
            --out-candidates "{output.candidates}" \
            --out-manifest "{OPEN_HOST_DIR}/_open_host_all_manifest.csv" \
            --out-combined "{OPEN_HOST_DIR}/_open_host_all_combined.csv" \
            > "{log}" 2>&1
        python3 scripts/open_host_specificity.py \
            --open-host-tsv "{output.candidates}" \
            --out-specificity-tsv "{output.specificity}" \
            --out-spotcheck-manifest "{output.manifest}" \
            >> "{log}" 2>&1
        rm -f "${{TMP_CFG}}" "{OPEN_HOST_DIR}/_open_host_all_manifest.csv" "{OPEN_HOST_DIR}/_open_host_all_combined.csv"
        """


rule open_host_enrichment:
    """Compute sampling-effort-normalized Fisher's exact host enrichment & library-source breakdown."""
    input:
        candidates = f"{OPEN_HOST_DIR}/open_host_candidates.tsv",
    output:
        enrichment   = f"{OPEN_HOST_DIR}/open_host_enrichment.tsv",
        denominators = f"{OPEN_HOST_DIR}/serratus_denominators.tsv",
    conda:
        ENV_SNOWBALL
    log:
        "logs/snowball/open_host_enrichment.log",
    shell:
        """
        mkdir -p $(dirname {log}) "{OPEN_HOST_DIR}"
        python3 scripts/open_host_enrichment.py \
            --open-host-tsv "{input.candidates}" \
            --query-serratus \
            --out-enrichment-tsv "{output.enrichment}" \
            --out-denominators-tsv "{output.denominators}" \
            > "{log}" 2>&1
        """


