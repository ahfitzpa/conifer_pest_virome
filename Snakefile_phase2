# 5. TARGET CONTROL
# =========================================================================
# One family's samples at a time -- a straight expand(family=FAMILIES,
# sample=SAMPLES.keys()) would be a full cross product and request
# targets for samples that don't belong to that family.
FINAL_TARGETS = [
    target
    for fam in FAMILIES
    for target in expand(
        "data/05.final_selection/{family}/{sample}/taxonomy_merged.tsv",
        family=[fam], sample=family_samples(fam),
    )
]

# See ENGINEERING_NOTES.md § taxonomy_cleanup: the rule itself already
# existed, but wasn't reachable from rule all, so its per-sample
# intermediate-file purge had never actually run.
PURGE_TARGETS = [
    target
    for fam in FAMILIES
    for target in expand(
        "data/04.taxonomy/{family}/{sample}/.purged",
        family=[fam], sample=family_samples(fam),
    )
]

# See ENGINEERING_NOTES.md § seqkit_stats: moved from raw reads to the
# rnaviralSPAdes assembly output, and wired into rule all (previously
# unreachable).
STATS_TARGETS = [
    target
    for fam in FAMILIES
    for target in expand(
        "data/03.assembly_stats/{family}/{sample}/{sample}_stats.txt",
        family=[fam], sample=family_samples(fam),
    )
]

# VirSorter2 used to be pulled into the DAG only as an input of
# annotate_viral_positives. Now that it is a params path there (so that a
# VirSorter2 failure cannot block a sample's merge, or MetaCerberus behind it),
# nothing would request these files and the rule would never run at all. They
# are therefore explicit targets. Failure here is not fatal to the merges:
# run_virsorter2 always creates its outputs, --keep-going covers a hard
# timeout, and annotate writes NA when the score is absent.
VIRSORTER_TARGETS = [
    target
    for fam in FAMILIES
    for target in expand(
        "data/03.rnaviralSPAdes/{family}/{sample}/virsorter2/final-viral-score.tsv",
        family=[fam], sample=family_samples(fam),
    )
]

rule all:
    input:
        os.path.join(config["databases"]["virsorter2_db"], ".done"),
        os.path.join(config["databases"]["checkv_db"], ".done"),
        os.path.join(config["databases"]["rdrp_catch_hmm"], ".done"),
        FINAL_TARGETS,
        PURGE_TARGETS,
        STATS_TARGETS,
        VIRSORTER_TARGETS,
