def deep_update(d, u):
    for k, v in u.items():
        if isinstance(v, dict) and isinstance(d.get(k), dict):
            deep_update(d[k], v)
        else:
            d[k] = v
    return d

config = {}
# Phase 3 (phylogenetics, genome maps, recombination, demarcation) is its own
# workflow in phase3/, which loads configs/phylogenetics.yaml itself.
for f in ["configs/paths.yaml", "configs/phase2_assembly_analysis.yaml"]:
    with open(f) as fh:
        deep_update(config, yaml.safe_load(fh))

# Opt-in overrides for the speed-up validation work. See
# ENGINEERING_NOTES.md § Snakefile_phase2 and docs/SPEEDUP_PLAN.md.
if os.environ.get("PHASE2_MANIFEST_OVERRIDE"):
    config["manifest"] = os.environ["PHASE2_MANIFEST_OVERRIDE"]

# Scratch-backed tmp, not node-local /tmp (small/shared, fills up fast).
# Set before anything else runs so every shell subprocess and snakemake's
# own tempfile use picks it up. See ENGINEERING_NOTES.md § Snakefile_phase2.
TMPDIR = os.path.join(os.getcwd(), config["paths"]["tmp"])
os.makedirs(TMPDIR, exist_ok=True)
os.environ["TMPDIR"] = TMPDIR

# accession must never span a path separator, otherwise Snakemake can't
# disambiguate references/hosts/{accession} from nested outputs like
# references/hosts/{accession}/mask.1.bt2
wildcard_constraints:
