def get_fastp_input(wildcards):
    # Always both paths, never os.path.exists(fq2): that's only correct
    # for samples already fetched by DAG-build time -- for any sample not
    # yet downloaded it misreads a genuinely-paired sample as single-end
    # (the old get_trimmed_inputs bug). fastp_cleaning's
    # shell always references {input.fq2} unconditionally (and its own
    # output always declares fq2), so this keeps the same always-both-paths
    # contract fastp_cleaning has always had.
    fam = SAMPLES[wildcards.sample]['family']
    sample = wildcards.sample
    return {
        "fq1": f"data/01.reads/{fam}/{sample}/{sample}_1.fastq.gz",
        "fq2": f"data/01.reads/{fam}/{sample}/{sample}_2.fastq.gz",
    }

