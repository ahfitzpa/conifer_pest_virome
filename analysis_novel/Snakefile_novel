import os
import yaml

# =========================================================================
# analysis_novel: the post-assembly pathway for the NOVEL manifest only.
#
# A sample goes through the pathway its manifest belongs to, not through all
# of them, so this workflow covers the novel scenario and the other three
# scenarios have their own directories. phase2 is consumed strictly as
# finished OUTPUT, read from ../phase2; nothing here writes into it.
#
# Built as a new directory rather than by renaming phase3, because a
# serratus_port job is still submitting phase3/submit_phase3.sh and
# serratus_commit is queued to commit that path. phase3's rules 09-12 and
# their scripts move in here once both have finished (todo.md task 3.1);
# until then this workflow runs the shared phylogeny, which is what the
# scenario pathways need first.
# =========================================================================


def deep_update(d, u):
    for k, v in u.items():
        if isinstance(v, dict) and isinstance(d.get(k), dict):
            deep_update(d[k], v)
        else:
            d[k] = v
    return d


# Layout differs between projects: Serratus has workflow/phase2 beside this
# directory, conifer keeps phase2 at the repo root. Detect rather than hardcode,
# so the same Snakefile serves both.
def _find_phase2():
    explicit = os.environ.get("PHASE2_DIR")
    if explicit:
        return explicit
    for candidate in ("../phase2", ".."):
        if os.path.exists(os.path.join(candidate, "configs/paths.yaml")):
            return candidate
    return "../phase2"


PHASE2 = _find_phase2()
COMMON = os.environ.get("COMMON_DIR", "../common")

# phase2's paths.yaml supplies the shared tools: block; the rest is this
# pathway's own, with common/configs/phylogeny.yaml underneath so the shared
# rule's defaults are defined before any override here.
# Snakemake has already populated `config` from --config / --configfile. Those
# values must survive: rebuilding the dict with `config = {}` (as
# Snakefile_phase3 did) silently discarded every command-line override, so a
# user pointing the pathway at their own data was ignored and quietly got the
# phase2 defaults instead.
_cli_config = dict(config)
config.clear()
# configs/phylogenetics.yaml carries the `phylogenetics:` block that rules 09-12
# read as config["phylogenetics"]; without it every one of them raises KeyError
# at parse. configs/novel.yaml is loaded last so this pathway can override.
for f in [os.path.join(PHASE2, "configs/paths.yaml"),
          os.path.join(COMMON, "configs/phylogeny.yaml"),
          "configs/phylogenetics.yaml",
          # Generated by phase2's contig_confidence step: the families holding
          # contigs that survived the annotation filter. Loaded BEFORE
          # novel.yaml so it acts as a default, not an override -- a project
          # that names its families explicitly must not be silently widened to
          # every family phase2 happened to retain.
          "configs/families.yaml",
          "configs/novel.yaml"]:
    if os.path.exists(f):
        with open(f) as fh:
            deep_update(config, yaml.safe_load(fh) or {})
# the command line wins over every yaml file
deep_update(config, _cli_config)

# Scratch-backed tmp, not node-local /tmp, for the same reason as phase2.
TMPDIR = os.path.join(os.getcwd(), "tmp")
os.makedirs(TMPDIR, exist_ok=True)
os.environ["TMPDIR"] = TMPDIR

# Inputs are declared, so this pathway runs on anyone's data, not only this
# project's phase2 outputs. NOVEL_MANIFEST and PHASE2_MANIFEST_OVERRIDE are
# still honoured as the manifest, for continuity with the existing scripts.
include: os.path.join(COMMON, "rules/inputs.smk")

_manifest_override = (os.environ.get("NOVEL_MANIFEST")
                      or (os.path.join(PHASE2, os.environ["PHASE2_MANIFEST_OVERRIDE"])
                          if os.environ.get("PHASE2_MANIFEST_OVERRIDE") else None))
if _manifest_override:
    config.setdefault("inputs", {})["manifest"] = _manifest_override

INPUTS = resolve_inputs(config, PHASE2, pathway="analysis_novel")
MANIFEST = INPUTS["manifest"]

# Families, in order of authority: an explicit novel.families, then the
# generated list from phase2, then nothing -- and nothing is an error rather
# than a silent run over every family that happens to have a bundle.
FAMILIES = (config.get("novel", {}).get("families")
            or config.get("phylogenetics", {}).get("families")
            or [])
if not FAMILIES:
    raise WorkflowError(
        "no families to analyse. Set novel: families: in configs/novel.yaml, "
        "or run phase2's contig_confidence step, which writes "
        "results/reporting/analysis_families.yaml for copying to "
        "configs/families.yaml.")
print(f"[families] analysing {len(FAMILIES)}: "
      + ", ".join(FAMILIES[:6]) + (" ..." if len(FAMILIES) > 6 else ""))
SCENARIO_PHYLO_DIR = "results/phylogeny"


def get_env(tool_key):
    """Resolve an env by its tools: key, searching this pathway, then common,
    then phase2.

    Falling back rather than copying keeps one definition of a shared
    environment, so they cannot drift between pathways.
    """
    name = config["tools"][tool_key] if tool_key in config.get("tools", {}) else tool_key
    here = os.path.dirname(workflow.snakefile)
    for base, rel in ((here, f"envs/{name}"),
                      (COMMON, f"envs/{name}"),
                      (PHASE2, f"envs/{name}")):
        if os.path.exists(os.path.join(base, rel)):
            return (workflow.source_path(rel) if base == here
                    else workflow.source_path(os.path.join(base, rel)))
    raise WorkflowError(
        f"env for {tool_key} ({name}) not found in analysis_novel/envs, "
        f"{COMMON}/envs or {PHASE2}/envs")


# Globals that rules 09-12 expect. In phase3 these came from Snakefile_phase3;
# they are constants pointing into phase2's finished results, so the rule files
# stay byte-identical to phase3's and can be re-synced without re-patching.
ICTV_DIR = os.path.join(PHASE2, "results/ictv")
REPORT_DIR = os.path.join(PHASE2, "results/reporting")
MASTER_DB = os.path.join(PHASE2, "results/master_viral_database.fasta")
MANIFEST_PATH = MANIFEST


def get_all_coverage_stats(wildcards):
    """Per-sample coverage_stats.tsv, read from phase2's data tree."""
    import csv
    with open(MANIFEST_PATH) as fh:
        return [
            os.path.join(PHASE2, "data/03.rnaviralSPAdes",
                         r["family"], r["sample_id"], "coverage_stats.tsv")
            for r in csv.DictReader(fh)
        ]


# The shared phylogeny comes first and uses SCENARIO_PHYLO_DIR /
# SCENARIO_PHYLO_ENV. Rules 09-12 set their own PHYLO_DIR ("results/phylo") and
# use PHYLO_ENV, so the two trees live side by side: the shared one places this
# scenario's contigs against references, while 09 builds the per-family domain
# and concatenated trees phase3 was written around.
include: os.path.join(COMMON, "rules/phylogeny.smk")
include: "rules/09.phylogenetics.smk"
