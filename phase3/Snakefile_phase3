import os
import yaml

# =========================================================================
# Phase 3: comparative phylogenetics, genome maps, recombination, ICTV
# demarcation.
#
# A SEPARATE workflow from phase2, not an include of it. The two have
# different units of analysis -- phase2 is per sample (assembly, taxonomy),
# phase3 is per viral family -- different runtimes, and different configs,
# and keeping them apart means a multi-hour IQ-TREE job can never re-enter
# or invalidate the assembly DAG. Ported from Serratus/workflow/phase3;
# conifer's phase2 lives at the project root, so PHASE2 defaults to "..".
#
# Phase 2 is consumed strictly as finished OUTPUT, read from .. (project root):
#   results/ictv/families.tsv + families/<fam>/     (ictv_prepare)
#   results/reporting/candidate_contigs.tsv         (candidate_contig_table)
#   results/reporting/metacerberus_orfs.faa         (export_metacerberus_orfs)
#   results/annotation/metacerberus/final/...       (run_metacerberus)
#   references/ictv_refs*.faa|tsv                   (scripts/fetch_refs*.py)
# Nothing here writes into phase2; phase3's own outputs land in this
# directory's results/.
# =========================================================================

def deep_update(d, u):
    for k, v in u.items():
        if isinstance(v, dict) and isinstance(d.get(k), dict):
            deep_update(d[k], v)
        else:
            d[k] = v
    return d


# phase2's paths.yaml supplies the shared `tools:` block (TAX_CORE_ENV and
# the phase3 *_ENV keys); configs/phylogenetics.yaml is phase3's own.
PHASE2 = os.environ.get("PHASE2_DIR", "..")

config = {}
for f in [os.path.join(PHASE2, "configs/paths.yaml"), "configs/phylogenetics.yaml"]:
    with open(f) as fh:
        deep_update(config, yaml.safe_load(fh))

# Scratch-backed tmp, not node-local /tmp, for the same reason as phase2.
TMPDIR = os.path.join(os.getcwd(), "tmp")
os.makedirs(TMPDIR, exist_ok=True)
os.environ["TMPDIR"] = TMPDIR

