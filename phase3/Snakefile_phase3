def get_env(tool_key):
    """Resolve an env by its `tools:` key: phase3's envs/ first, else phase2's.

    Rules 09-12 use phase3-only envs (PHYLO_ENV, RECOMB_ENV, ...) but also
    TAX_CORE_ENV, which is phase2's and is shared by both workflows. Falling
    back rather than copying tax_core.yaml here keeps one definition of the
    shared environments, so they cannot drift between the two phases.
    """
    name = config["tools"][tool_key]
    local = os.path.join(os.path.dirname(workflow.snakefile), "envs", name)
    if os.path.exists(local):
        return workflow.source_path(f"envs/{name}")
    shared = os.path.join(PHASE2, "envs", name)
    if os.path.exists(shared):
        return workflow.source_path(f"{PHASE2}/envs/{name}")
    raise WorkflowError(
        f"env for {tool_key} ({name}) not found in phase3/envs or {PHASE2}/envs"
    )


# rules/10.genome_maps.smk reaches back into phase2 for two things that are
# not config-driven: per-sample coverage, and the master database. Both are
# supplied here so the rule files stay byte-identical to Serratus phase3's and
# can be re-synced without re-patching.
MANIFEST_PATH = os.path.join(PHASE2, config.get("manifest", "data/test_run/manifest.csv"))


def get_all_coverage_stats(wildcards):
    """Per-sample coverage_stats.tsv, read from phase2's data tree."""
    import csv
    with open(MANIFEST_PATH) as fh:
        return [
            os.path.join(PHASE2, "data/03.rnaviralSPAdes",
                         r["family"], r["sample_id"], "coverage_stats.tsv")
            for r in csv.DictReader(fh)
        ]


